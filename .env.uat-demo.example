UAT_DEMO_REAL_PAYMENT_ALLOWED=false
UAT_DEMO_REAL_PAYOUT_ALLOWED=false
UAT_DEMO_REAL_SHIPMENT_ALLOWED=false
UAT_DEMO_REAL_EXTERNAL_KYC_ALLOWED=false
UAT_DEMO_REAL_LIVESTREAM_ALLOWED=false
