# Copy to an ignored .env.uat.local or inject through the UAT secret manager.
# Never commit values from this file.
NODE_ENV=uat
PORT=3001
HOST=127.0.0.1

# UAT isolation guard (all values below are required for reset/seed).
UAT_ENVIRONMENT=true
UAT_ISOLATION_CONFIRMED=true
UAT_DATABASE_TARGET=antifake-uat-postgres
UAT_DATABASE_NAME=antifake_uat
UAT_DATABASE_HOST_ALLOWLIST=
UAT_PRODUCTION_DATABASE_TARGET=antifake-production-postgres
DATABASE_URL=
UAT_FRONTEND_PUBLIC_URL=http://127.0.0.1:4173
UAT_TEST_PASSWORD=
UAT_QR_CODE=
PAYOUT_ACCOUNT_ENCRYPTION_KEY=

FRONTEND_URL=http://127.0.0.1:4173
BACKEND_PUBLIC_URL=http://127.0.0.1:3001
API_PUBLIC_URL=http://127.0.0.1:3001
API_BASE_URL=http://127.0.0.1:3001/api
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173

# Application secrets are UAT-only values supplied by the secret manager.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=7d

# Realtime is local/in-process by default. Set REDIS_ENABLED=true only with an
# isolated UAT Redis namespace/instance.
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_DB=0
REDIS_KEY_PREFIX=antifake-uat:

# Optional provider configuration. Leave blank to keep provider steps blocked.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_BASE_URL=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
GHN_BASE_URL=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_PAYMENT_TYPE_ID=
GHN_SERVICE_TYPE_ID=
VIETQR_API_BASE_URL=
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
