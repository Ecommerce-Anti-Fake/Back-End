NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://cpanel_user:replace-with-password@database-host:5432/antifake

FRONTEND_URL=https://example.com
BACKEND_PUBLIC_URL=https://api.example.com
API_PUBLIC_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://api.example.com
CORS_ORIGIN=https://example.com
API_JSON_BODY_LIMIT=5mb

JWT_SECRET=replace-with-long-random-jwt-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=replace-with-long-random-refresh-secret
REFRESH_TOKEN_TTL=7d

AUTH_SERVICE_PORT=4001
USERS_SERVICE_PORT=4002
CATALOG_SERVICE_PORT=4003
ORDERS_SERVICE_PORT=4004
AFFILIATE_SERVICE_PORT=4005

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=antifake
REDIS_DEFAULT_TTL_SECONDS=300

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

AGORA_APP_ID=00000000000000000000000000000000
AGORA_APP_CERTIFICATE=00000000000000000000000000000000
AGORA_RTC_TOKEN_TTL_SECONDS=3600

FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-escaped-private-key

PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECK_SUM_KEY=replace-with-payos-checksum-key
PAYOS_API_BASE_URL=https://api-merchant.payos.vn

GHN_BASE_URL=https://online-gateway.ghn.vn
GHN_TOKEN=replace-with-ghn-token
GHN_SHOP_ID=123456
GHN_FROM_DISTRICT_ID=1234
GHN_PAYMENT_TYPE_ID=2
GHN_REQUIRED_NOTE=KHONGCHOXEMHANG
GHN_SERVICE_TYPE_ID=2

BANK_ACCOUNT_LOOKUP_ENABLED=false
VIETQR_API_BASE_URL=https://api.vietqr.io
VIETQR_CLIENT_ID=replace-with-vietqr-client-id
VIETQR_API_KEY=replace-with-vietqr-api-key

SELLER_WITHDRAWALS_ENABLED=false
BUYER_WITHDRAWALS_ENABLED=false
PAYOUT_ACCOUNT_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex-key

COD_SHOP_SETTLEMENT_ENABLED=false
COD_DEBT_GRACE_HOURS=24
AFFILIATE_ATTRIBUTION_SECRET=replace-with-affiliate-attribution-secret
AFFILIATE_COMMISSION_HOLD_DAYS=7
AFFILIATE_SETTLEMENT_INTERVAL_MS=3600000
