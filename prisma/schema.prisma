  @@map("shipping_carrier")
}

model ShopBusinessCategory {
  id                 String                 @id @default(uuid())
  shopId             String                 @map("shop_id")
  categoryId         String                 @map("category_id")
  registrationStatus String                 @default("pending") @map("registration_status")
  approvedAt         DateTime?              @map("approved_at")
  reviewNote         String?                @map("review_note")
  createdAt          DateTime               @default(now()) @map("created_at")
  shop               Shop                   @relation(fields: [shopId], references: [id])
  category           Category               @relation(fields: [categoryId], references: [id])

  @@unique([shopId, categoryId])
  @@index([shopId])
  @@index([categoryId])
  @@map("shop_business_category")
}

model ShopDocumentFile {
  id             String       @id @default(uuid())
  shopDocumentId String       @map("shop_document_id")
  mediaAssetId   String       @unique @map("media_asset_id")
  fileUrl        String       @map("file_url")
  sortOrder      Int          @default(0) @map("sort_order")
  uploadedAt     DateTime     @default(now()) @map("uploaded_at")
  shopDocument   ShopDocument @relation(fields: [shopDocumentId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset   @relation(fields: [mediaAssetId], references: [id])

  @@index([shopDocumentId])
  @@map("shop_document_file")
}

model ShopDocument {
  id            String                   @id @default(uuid())
  shopId        String                   @map("shop_id")
  requirementId String?                  @map("requirement_id")
  docType       String                   @map("doc_type")
  reviewStatus  String                   @map("review_status")
  reviewNote    String?                  @map("review_note")
  reviewedAt    DateTime?                @map("reviewed_at")
  uploadedAt    DateTime                 @default(now()) @map("uploaded_at")
  shop          Shop                     @relation(fields: [shopId], references: [id])
  requirement   VerificationRequirement? @relation(fields: [requirementId], references: [id])
  files         ShopDocumentFile[]

  @@index([shopId])
  @@index([requirementId])
  @@index([docType])
  @@map("shop_document")
}

model ShopTypeRequirement {
  id            String                  @id @default(uuid())
  shopTypeId    String                  @map("shop_type_id")
  requirementId String                  @map("requirement_id")
  required      Boolean                 @default(true)
  sortOrder     Int                     @default(0) @map("sort_order")
  isActive      Boolean                 @default(true) @map("is_active")
  shopType      ShopType                @relation(fields: [shopTypeId], references: [id], onDelete: Cascade)
  requirement   VerificationRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([shopTypeId, requirementId])
  @@index([requirementId])
  @@index([isActive, sortOrder])
  @@map("shop_type_requirement")
}

model ShopType {
  id           String                @id @default(uuid())
  code         String                @unique
  name         String
  description  String?
  isActive     Boolean               @default(true) @map("is_active")
  sortOrder    Int                   @default(0) @map("sort_order")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  shops        Shop[]
  requirements ShopTypeRequirement[]

  @@index([isActive, sortOrder])
  @@map("shop_type")
}

model Shop {
  id                         String                 @id @default(uuid())
  ownerUserId                String                 @map("owner_user_id")
  shopTypeId                 String?                @map("shop_type_id")
  shopName                   String                 @map("shop_name")
  registrationType           ShopRegistrationType   @map("registration_type")
  businessType               String                 @map("business_type")
  taxCode                    String?                @map("tax_code")
  phone                      String?
  shopStatus                 String                 @map("shop_status")
  avatarMediaId              String?                @map("avatar_media_id") @unique
  bannerMediaId              String?                @map("banner_media_id") @unique
  warehouseAddress           String?                @map("warehouse_address")
  warehouseProvinceCode      String?                @map("warehouse_province_code")
  warehouseProvinceName      String?                @map("warehouse_province_name")
  warehouseWardCode          String?                @map("warehouse_ward_code")
  warehouseWardName          String?                @map("warehouse_ward_name")
  createdAt                  DateTime               @default(now()) @map("created_at")
  avatarMedia                MediaAsset?            @relation("ShopAvatar", fields: [avatarMediaId], references: [id])
  bannerMedia                MediaAsset?            @relation("ShopBanner", fields: [bannerMediaId], references: [id])
  owner                      User                   @relation("ShopOwner", fields: [ownerUserId], references: [id])
  shopType                   ShopType?              @relation(fields: [shopTypeId], references: [id])
  documents                  ShopDocument[]
  registeredCategories       ShopBusinessCategory[]
  brandAuthorizations        BrandAuthorization[]
  offers                     Offer[]
  supplyBatches              SupplyBatch[]
  orders                     Order[]
  orderGroups                OrderShopGroup[]
  wholesaleOrders            Order[]                @relation("OrderBuyerShop")
  distributionNetworksAsRoot DistributionNetwork[]  @relation("DistributionManufacturerShop")
  distributionNodes          DistributionNode[]
  affiliatePrograms          AffiliateProgram[]
  chatThreads                ChatThread[]
  socialPosts                SocialPost[]
  liveSessions               LiveCommerceSession[]
  wallets                    Wallet[]

  @@index([shopTypeId])
  @@map("shop")
}

model SocialCommentLike {
  id        String        @id @default(uuid())
  commentId String        @map("comment_id")
  userId    String        @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  comment   SocialComment @relation(fields: [commentId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([userId, createdAt])
  @@map("social_comment_like")
}

model SocialComment {
  id              String               @id @default(uuid())
  postId          String               @map("post_id")
  parentCommentId String?              @map("parent_comment_id")
  authorUserId    String               @map("author_user_id")
  body            String
  visibility      SocialPostVisibility @default(PUBLIC)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  post            SocialPost           @relation(fields: [postId], references: [id])
  parentComment   SocialComment?       @relation("SocialCommentThread", fields: [parentCommentId], references: [id])
  replies         SocialComment[]      @relation("SocialCommentThread")
  author          User                 @relation(fields: [authorUserId], references: [id])
  likes           SocialCommentLike[]

  @@index([postId, createdAt])
  @@index([parentCommentId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("social_comment")
}

model SocialPostMedia {
  id           String     @id @default(uuid())
  postId       String     @map("post_id")
  mediaAssetId String     @map("media_asset_id")
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  post         SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@unique([postId, mediaAssetId])
  @@index([postId, sortOrder])
  @@index([mediaAssetId])
  @@map("social_post_media")
}

model SocialPost {
  id             String               @id @default(uuid())
  authorUserId   String               @map("author_user_id")
  authorShopId   String?              @map("author_shop_id")
  offerId        String?              @map("offer_id")
  postType       SocialPostType       @map("post_type")
  body           String
  visibility     SocialPostVisibility @default(PUBLIC)
  hiddenAt       DateTime?            @map("hidden_at")
  hiddenByUserId String?              @map("hidden_by_user_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  author         User                 @relation(fields: [authorUserId], references: [id])
  authorShop     Shop?                @relation(fields: [authorShopId], references: [id])
  offer          Offer?               @relation(fields: [offerId], references: [id])
  comments       SocialComment[]
  reactions      SocialReaction[]
  shares         SocialShare[]
  media          SocialPostMedia[]

  @@index([authorUserId, createdAt])
  @@index([authorShopId, createdAt])
  @@index([offerId])
  @@index([visibility, createdAt])
  @@map("social_post")
}

model SocialReaction {
  id           String             @id @default(uuid())
  postId       String             @map("post_id")
  userId       String             @map("user_id")
  reactionType SocialReactionType @default(LIKE) @map("reaction_type")
  createdAt    DateTime           @default(now()) @map("created_at")
  post         SocialPost         @relation(fields: [postId], references: [id])
  user         User               @relation(fields: [userId], references: [id])

  @@unique([postId, userId, reactionType])
  @@index([userId, createdAt])
  @@map("social_reaction")
}

model SocialShare {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      SocialPost @relation(fields: [postId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("social_share")
}

model SupplyBatch {
  id                   String                     @id @default(uuid())
  shopId               String                     @map("shop_id")
  brandId              String                     @map("brand_id")
  categoryId           String                     @map("category_id")
  distributionNodeId   String?                    @map("distribution_node_id")
  modelName            String                     @map("model_name")
  gtin                 String?
  verificationPolicy   String                     @map("verification_policy")
  batchNumber          String                     @map("batch_number")
  quantity             Int                        @map("quantity")
  sourceName           String                     @map("source_name")
  countryOfOrigin      String                     @map("country_of_origin")
  sourceType           String                     @map("source_type")
  sourceOrderId        String?                    @map("source_order_id")
  sourceOrderItemId    String?                    @map("source_order_item_id")
  receivedAt           DateTime                   @map("received_at")
  shop                 Shop                       @relation(fields: [shopId], references: [id])
  brand                Brand                      @relation(fields: [brandId], references: [id])
  category             Category                   @relation(fields: [categoryId], references: [id])
  distributionNode     DistributionNode?          @relation(fields: [distributionNodeId], references: [id])
  sourceOrder          Order?                     @relation("SupplyBatchSourceOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  sourceOrderItem      OrderItem?                 @relation("SupplyBatchSourceOrderItem", fields: [sourceOrderItemId], references: [id], onDelete: SetNull)
  documents            BatchDocument[]
  offerLinks           OfferBatchLink[]
  orderItemAllocations OrderItemBatchAllocation[]
  shipmentItems        DistributionShipmentItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([distributionNodeId])
  @@index([sourceOrderId])
  @@index([sourceOrderItemId])
  @@map("supply_batch")
}

model UserAddress {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  recipientName String   @map("recipient_name")
  phone         String
  addressLine   String   @map("address_line")
  provinceCode         String?  @map("province_code")
  provinceName         String?  @map("province_name")
  wardCode             String?  @map("ward_code")
  wardName             String?  @map("ward_name")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_address")
}

model UserFavoriteOffer {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  offerId   String   @map("offer_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([userId])
  @@index([offerId])
  @@map("user_favorite_offer")
}

model UserKycDocument {
  id           String          @id @default(uuid())
  userKycId    String          @map("user_kyc_id")
  mediaAssetId String          @map("media_asset_id")
  side         KycDocumentSide
  uploadedAt   DateTime        @default(now()) @map("uploaded_at")
  userKyc      UserKyc         @relation(fields: [userKycId], references: [id])
  mediaAsset   MediaAsset      @relation(fields: [mediaAssetId], references: [id])

  @@unique([userKycId, side])
  @@unique([mediaAssetId])
  @@index([userKycId])
  @@map("user_kyc_document")
}

model UserKycSubmissionDocument {
  id           String            @id @default(uuid())
  submissionId String            @map("submission_id")
  mediaAssetId String            @unique @map("media_asset_id")
  side         KycDocumentSide
  uploadedAt   DateTime          @default(now()) @map("uploaded_at")
  submission   UserKycSubmission @relation(fields: [submissionId], references: [id])
  mediaAsset   MediaAsset        @relation(fields: [mediaAssetId], references: [id])

  @@unique([submissionId, side])
  @@index([submissionId])
  @@map("user_kyc_submission_document")
}

model UserKycSubmission {
  id                 String                      @id @default(uuid())
  userKycId          String                      @map("user_kyc_id")
  submissionNumber   Int                         @map("submission_number")
  verificationStatus String                      @default("pending") @map("verification_status")
  reviewNote         String?                     @map("review_note")
  reviewedAt         DateTime?                   @map("reviewed_at")
  submittedAt        DateTime                    @default(now()) @map("submitted_at")
  userKyc            UserKyc                     @relation(fields: [userKycId], references: [id])
  documents          UserKycSubmissionDocument[]

  @@unique([userKycId, submissionNumber])
  @@index([userKycId, submittedAt])
  @@map("user_kyc_submission")
}

model UserKyc {
  id                 String              @id @default(uuid())
  userId             String              @unique @map("user_id")
  fullName           String              @map("full_name")
  dateOfBirth        DateTime            @map("date_of_birth")
  kycLevel           String              @map("kyc_level")
  idType             String              @map("id_type")
  idNumberHash       String              @map("id_number_hash")
  verificationStatus String              @map("verification_status")
  verifiedAt         DateTime?           @map("verified_at")
  reviewNote         String?             @map("review_note")
  user               User                @relation(fields: [userId], references: [id])
  documents          UserKycDocument[]
  submissions        UserKycSubmission[]

  @@map("user_kyc")
}

model User {
  id                   String                @id @default(uuid())
  phone                String?               @unique
  email                String?               @unique
  displayName          String?               @map("display_name")
  password             String?
  role                 String                @default("user")
  accountStatus        String                @default("active") @map("account_status")
  avatarMediaId        String?               @map("avatar_media_id") @unique
  avatarMedia          MediaAsset?           @relation("UserAvatarMedia", fields: [avatarMediaId], references: [id])
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  authSessions         AuthSession[]
  passwordResetTokens  PasswordResetToken[]
  kyc                  UserKyc?
  ownedShops           Shop[]                @relation("ShopOwner")
  offers               Offer[]               @relation("OfferSeller")
  carts                Cart[]
  orders               Order[]               @relation("OrderBuyer")
  disputesOpened       Dispute[]             @relation("DisputeOpenedBy")
  disputeEvidence      DisputeEvidence[]     @relation("DisputeEvidenceUploadedBy")
  mediaAssets          MediaAsset[]          @relation("MediaAssetOwner")
  auditLogs            AuditLog[]            @relation("AuditLogActor")
  reviewsGiven         Review[]              @relation("ReviewFromUser")
  reviewsReceived      Review[]              @relation("ReviewToUser")
  chatThreadsAsBuyer   ChatThread[]          @relation("ChatThreadBuyer")
  chatThreadsAsSeller  ChatThread[]          @relation("ChatThreadSeller")
  chatMessages         ChatMessage[]         @relation("ChatMessageSender")
  reports              Report[]              @relation("ReportReporter")
  moderationCases      ModerationCase[]      @relation("ModerationCaseAssignee")
  provenanceEvents     ProvenanceEvent[]     @relation("ProvenanceEventActor")
  affiliateAccounts    AffiliateAccount[]
  affiliateConversions AffiliateConversion[] @relation("AffiliateConversionCustomer")
  addresses            UserAddress[]
  notifications        Notification[]
  notificationFcmTokens NotificationFcmToken[]
  notificationDeliveryAttempts NotificationDeliveryAttempt[]
  favoriteOffers       UserFavoriteOffer[]
  socialPosts          SocialPost[]
  socialComments       SocialComment[]
  socialCommentLikes   SocialCommentLike[]
  socialReactions      SocialReaction[]
  socialShares         SocialShare[]
  liveSessionReminders LiveSessionReminder[]
  liveSessionComments  LiveSessionComment[] @relation("LiveCommentAuthor")
  hiddenLiveSessionComments LiveSessionComment[] @relation("LiveCommentHiddenBy")
  wallets               Wallet[]

  @@map("user")
}

model VerificationLabel {
  id          String            @id @default(uuid())
  brandId     String            @map("brand_id")
  labelType   String            @map("label_type")
  codeHash    String            @map("code_hash")
  issuerType  String            @map("issuer_type")
  labelStatus String            @map("label_status")
  scopeType   String            @map("scope_type")
  scopeId     String            @map("scope_id")
  issuedAt    DateTime          @map("issued_at")
  brand       Brand             @relation(fields: [brandId], references: [id])
  provenance  ProvenanceEvent[]

  @@map("verification_label")
}

model VerificationRequirement {
  id                   String                @id @default(uuid())
  code                 String                @unique
  name                 String
  description          String?
  multipleFilesAllowed Boolean               @default(true) @map("multiple_files_allowed")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  shopTypes            ShopTypeRequirement[]
  shopDocuments        ShopDocument[]
  @@index([isActive])
  @@map("verification_requirement")
}

model WalletWithdrawal {
  id            String             @id @default(uuid())
  walletId      String             @map("wallet_id")
  amount        Decimal            @db.Decimal(18, 2)
  bankName      String             @map("bank_name")
  accountNumber String             @map("account_number")
  accountHolder String             @map("account_holder")
  status        WithdrawalStatus   @default(PENDING)
  createdAt     DateTime           @default(now()) @map("created_at")
  processedAt   DateTime?          @map("processed_at")

  wallet        Wallet             @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_withdrawal")
}

model Wallet {
  id               String          @id @default(uuid())
  walletCode       String          @unique @map("wallet_code")
  ownerType        WalletOwnerType @map("owner_type")
  userId           String?         @map("user_id")
  shopId           String?         @map("shop_id")
  platformCode     String?         @unique @map("platform_code")
  currency         String          @default("VND")
  availableBalance Decimal         @default(0) @map("available_balance") @db.Decimal(18, 2)
  pendingBalance   Decimal         @default(0) @map("pending_balance") @db.Decimal(18, 2)
  lockedBalance    Decimal         @default(0) @map("locked_balance") @db.Decimal(18, 2)
  status           WalletStatus    @default(ACTIVE)
  version          Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user             User?           @relation(fields: [userId], references: [id])
  shop             Shop?           @relation(fields: [shopId], references: [id])
  ledgerEntries    WalletLedgerEntry[]
  withdrawals      WalletWithdrawal[]

  @@unique([userId, currency])
  @@unique([shopId, currency])
  @@map("wallet")
}

model WalletTransaction {
  id                String                  @id @default(uuid())
  transactionCode   String                  @unique @map("transaction_code")
  transactionType   WalletTransactionType   @map("transaction_type")
  status            WalletTransactionStatus @default(PENDING)
  amount            Decimal                 @db.Decimal(18, 2)
  currency          String                  @default("VND")
  idempotencyKey    String                  @unique @map("idempotency_key")
  referenceType     String?                 @map("reference_type")
  referenceId       String?                 @map("reference_id")
  orderId           String?                 @map("order_id")
  paymentIntentId   String?                 @map("payment_intent_id")
  description       String?
  createdAt         DateTime                @default(now()) @map("created_at")
  completedAt       DateTime?               @map("completed_at")

  ledgerEntries     WalletLedgerEntry[]
  order             Order?                  @relation(fields: [orderId], references: [id])
  paymentIntent     PaymentIntent?          @relation(fields: [paymentIntentId], references: [id])

  @@index([referenceType, referenceId])
  @@index([orderId])
  @@index([paymentIntentId])
  @@map("wallet_transaction")
}

model WalletLedgerEntry {
  id              String               @id @default(uuid())
  walletId        String               @map("wallet_id")
  transactionId   String               @map("transaction_id")
  direction       WalletEntryDirection
  balanceType     WalletBalanceType    @map("balance_type")
  amount          Decimal              @db.Decimal(18, 2)
  balanceBefore   Decimal              @map("balance_before") @db.Decimal(18, 2)
  balanceAfter    Decimal              @map("balance_after") @db.Decimal(18, 2)
  createdAt       DateTime             @default(now()) @map("created_at")

  wallet          Wallet               @relation(fields: [walletId], references: [id])
  transaction     WalletTransaction    @relation(fields: [transactionId], references: [id])

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@map("wallet_ledger_entry")
}
