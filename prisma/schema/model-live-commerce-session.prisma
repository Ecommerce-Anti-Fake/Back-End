model LiveCommerceSession {
  id          String            @id @default(uuid())
  shopId      String            @map("shop_id")
  title       String
  description String?
  coverUrl    String?           @map("cover_url")
  pinnedOfferId String?         @map("pinned_offer_id")
  startAt     DateTime          @map("start_at")
  status      LiveSessionStatus @default(SCHEDULED)
  playbackUrl String?           @map("playback_url")
  streamProvider          String? @map("stream_provider")
  streamProviderSessionId String? @unique @map("stream_provider_session_id")
  streamIngestUrl         String? @map("stream_ingest_url")
  streamLatencyTargetMs   Int?    @map("stream_latency_target_ms")
  providerStatus          String? @map("provider_status")
  providerEventAt         DateTime? @map("provider_event_at")
  providerEventType       String? @map("provider_event_type")
  providerErrorCode       String? @map("provider_error_code")
  providerErrorMessage    String? @map("provider_error_message")
  actualStartedAt         DateTime? @map("actual_started_at")
  actualEndedAt           DateTime? @map("actual_ended_at")
  recordingUrl            String? @map("recording_url")
  recordingRetentionDays  Int?    @map("recording_retention_days")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  shop        Shop              @relation(fields: [shopId], references: [id])
  pinnedOffer Offer?            @relation("LiveSessionPinnedOffer", fields: [pinnedOfferId], references: [id], onDelete: SetNull)
  offers      LiveSessionOffer[]
  reminders   LiveSessionReminder[]
  vouchers    LiveSessionVoucher[]
  comments    LiveSessionComment[]
  sourceCartItems  CartItem[]  @relation("CartItemLiveSource")
  sourceOrderItems OrderItem[] @relation("OrderItemLiveSource")

  @@index([shopId, startAt])
  @@index([status, startAt])
  @@index([pinnedOfferId])
  @@map("live_commerce_session")
}
