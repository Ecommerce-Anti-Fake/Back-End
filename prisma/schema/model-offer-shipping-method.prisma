model OfferShippingMethod {
  id            String          @id @default(uuid())
  offerId       String          @map("offer_id")
  carrierId     String          @map("carrier_id")
  providerCode  String          @map("provider_code")
  providerName  String          @map("provider_name")
  shippingFee   Decimal         @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  estimatedDays String?         @map("estimated_days")
  isEnabled     Boolean         @default(true) @map("is_enabled")
  createdAt     DateTime        @default(now()) @map("created_at")
  offer         Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  carrier       ShippingCarrier @relation(fields: [carrierId], references: [id])

  @@unique([offerId, providerCode])
  @@index([carrierId])
  @@map("offer_shipping_method")
}
