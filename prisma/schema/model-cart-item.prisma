model CartItem {
  id                 String   @id @default(uuid())
  cartId             String   @map("cart_id")
  offerId            String   @map("offer_id")
  variantId          String?  @map("variant_id")
  sourceLiveSessionId String? @map("source_live_session_id")
  quantity           Int
  offerTitleSnapshot String   @map("offer_title_snapshot")
  unitPriceSnapshot  Decimal  @map("unit_price_snapshot") @db.Decimal(18, 2)
  currencySnapshot   String   @map("currency_snapshot")
  shopNameSnapshot   String   @map("shop_name_snapshot")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  cart               Cart     @relation(fields: [cartId], references: [id])
  offer              Offer    @relation(fields: [offerId], references: [id])
  variant            OfferVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sourceLiveSession  LiveCommerceSession? @relation("CartItemLiveSource", fields: [sourceLiveSessionId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([offerId])
  @@index([variantId])
  @@index([sourceLiveSessionId])
  @@map("cart_item")
}
