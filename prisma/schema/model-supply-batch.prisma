model SupplyBatch {
  id                   String                     @id @default(uuid())
  shopId               String                     @map("shop_id")
  brandId              String                     @map("brand_id")
  categoryId           String                     @map("category_id")
  distributionNodeId   String?                    @map("distribution_node_id")
  modelName            String                     @map("model_name")
  gtin                 String?
  verificationPolicy   String                     @map("verification_policy")
  batchNumber          String                     @map("batch_number")
  quantity             Int                        @map("quantity")
  sourceName           String                     @map("source_name")
  countryOfOrigin      String                     @map("country_of_origin")
  sourceType           String                     @map("source_type")
  sourceOrderId        String?                    @map("source_order_id")
  sourceOrderItemId    String?                    @map("source_order_item_id")
  receivedAt           DateTime                   @map("received_at")
  shop                 Shop                       @relation(fields: [shopId], references: [id])
  brand                Brand                      @relation(fields: [brandId], references: [id])
  category             Category                   @relation(fields: [categoryId], references: [id])
  distributionNode     DistributionNode?          @relation(fields: [distributionNodeId], references: [id])
  sourceOrder          Order?                     @relation("SupplyBatchSourceOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  sourceOrderItem      OrderItem?                 @relation("SupplyBatchSourceOrderItem", fields: [sourceOrderItemId], references: [id], onDelete: SetNull)
  documents            BatchDocument[]
  offerLinks           OfferBatchLink[]
  orderItemAllocations OrderItemBatchAllocation[]
  shipmentItems        DistributionShipmentItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([distributionNodeId])
  @@index([sourceOrderId])
  @@index([sourceOrderItemId])
  @@map("supply_batch")
}
