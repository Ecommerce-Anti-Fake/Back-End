model VerificationRequirement {
  id                   String                @id @default(uuid())
  code                 String                @unique
  name                 String
  description          String?
  multipleFilesAllowed Boolean               @default(true) @map("multiple_files_allowed")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  shopTypes            ShopTypeRequirement[]
  shopDocuments        ShopDocument[]
  @@index([isActive])
  @@map("verification_requirement")
}
