model CheckoutSession {
  id                 String    @id @default(uuid())
  buyerUserId        String    @map("buyer_user_id")
  cartItemIds        Json      @map("cart_item_ids")
  shippingOptionCode String    @map("shipping_option_code")
  paymentMethod      String    @map("payment_method")
  paymentStatus      String    @default("PENDING") @map("payment_status")
  amount             Decimal   @db.Decimal(18, 2)
  paymentProviderRef String?   @unique @map("payment_provider_ref")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  completedAt        DateTime? @map("completed_at")
  failedAt           DateTime? @map("failed_at")

  @@index([buyerUserId, paymentStatus])
  @@map("checkout_session")
}
