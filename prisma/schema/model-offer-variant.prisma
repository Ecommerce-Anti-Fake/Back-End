model OfferVariant {
  id                String              @id @default(uuid())
  offerId           String              @map("offer_id")
  sku               String?
  price             Decimal?            @db.Decimal(18, 2)
  availableQuantity Int                 @map("available_quantity")
  mediaAssetId      String?             @map("media_asset_id")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  offer             Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  mediaAsset        MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  values            OfferVariantValue[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@unique([offerId, sku])
  @@index([offerId, isActive, createdAt])
  @@index([mediaAssetId])
  @@map("offer_variant")
}
