model OrderItem {
  id                        String                     @id @default(uuid())
  orderId                   String                     @map("order_id")
  orderShopGroupId          String?                    @map("order_shop_group_id")
  sourceCartItemId          String?                    @map("source_cart_item_id")
  offerId                   String                     @map("offer_id")
  offerTitleSnapshot        String                     @map("offer_title_snapshot")
  unitPrice                 Decimal                    @map("unit_price") @db.Decimal(18, 2)
  quantity                  Int
  verificationLevelSnapshot String                     @map("verification_level_snapshot")
  order                     Order                      @relation(fields: [orderId], references: [id])
  orderShopGroup            OrderShopGroup?            @relation(fields: [orderShopGroupId], references: [id])
  offer                     Offer                      @relation(fields: [offerId], references: [id])
  batchAllocations          OrderItemBatchAllocation[]
  reviews                   Review[]
  sourceSupplyBatches       SupplyBatch[]                @relation("SupplyBatchSourceOrderItem")

  @@index([orderId])
  @@index([orderShopGroupId])
  @@index([sourceCartItemId])
  @@index([offerId])
  @@map("order_item")
}
