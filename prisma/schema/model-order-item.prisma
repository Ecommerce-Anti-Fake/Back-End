model OrderItem {
  id                        String                     @id @default(uuid())
  orderId                   String                     @map("order_id")
  orderShopGroupId          String?                    @map("order_shop_group_id")
  sourceCartItemId          String?                    @map("source_cart_item_id")
  offerId                   String                     @map("offer_id")
  variantId                 String?                    @map("variant_id")
  offerTitleSnapshot        String                     @map("offer_title_snapshot")
  unitPrice                 Decimal                    @map("unit_price") @db.Decimal(18, 2)
  quantity                  Int
  shopProductDiscountAmount   Decimal                  @default(0) @map("shop_product_discount_amount") @db.Decimal(18, 2)
  systemProductDiscountAmount Decimal                  @default(0) @map("system_product_discount_amount") @db.Decimal(18, 2)
  platformFeeAmount           Decimal                  @default(0) @map("platform_fee_amount") @db.Decimal(18, 2)
  order                     Order                      @relation(fields: [orderId], references: [id])
  orderShopGroup            OrderShopGroup?            @relation(fields: [orderShopGroupId], references: [id])
  offer                     Offer                      @relation(fields: [offerId], references: [id])
  variant                   OfferVariant?              @relation(fields: [variantId], references: [id], onDelete: SetNull)
  selectedOptions           OrderItemOptionValue[]
  batchAllocations          OrderItemBatchAllocation[]
  reviews                   Review[]
  sourceSupplyBatches       SupplyBatch[]                @relation("SupplyBatchSourceOrderItem")

  @@index([orderId])
  @@index([orderShopGroupId])
  @@index([sourceCartItemId])
  @@index([offerId])
  @@index([variantId])
  @@map("order_item")
}
