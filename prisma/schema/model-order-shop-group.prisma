model OrderShopGroup {
  id                     String      @id @default(uuid())
  orderId                String      @map("order_id")
  shopId                 String      @map("shop_id")
  fulfillmentStatus      String      @default("PENDING") @map("fulfillment_status")
  baseAmount             Decimal     @map("base_amount") @db.Decimal(18, 2)
  discountAmount         Decimal     @default(0) @map("discount_amount") @db.Decimal(18, 2)
  platformFeeAmount      Decimal     @default(0) @map("platform_fee_amount") @db.Decimal(18, 2)
  sellerReceivableAmount Decimal     @map("seller_receivable_amount") @db.Decimal(18, 2)
  shippingName           String?     @map("shipping_name")
  shippingPhone          String?     @map("shipping_phone")
  shippingAddress        String?     @map("shipping_address")
  shippingDistrictId     Int?        @map("shipping_district_id")
  shippingDistrictName   String?     @map("shipping_district_name")
  shippingWardCode       String?     @map("shipping_ward_code")
  shippingWardName       String?     @map("shipping_ward_name")
  shippingProviderCode   String?     @map("shipping_provider_code")
  shippingProviderName   String?     @map("shipping_provider_name")
  shippingServiceId      Int?        @map("shipping_service_id")
  shippingServiceTypeId  Int?        @map("shipping_service_type_id")
  shippingFeeAmount      Decimal     @default(0) @map("shipping_fee_amount") @db.Decimal(18, 2)
  shippingTrackingCode   String?     @map("shipping_tracking_code")
  parcelWeightGrams      Int?        @map("parcel_weight_grams")
  parcelLengthCm         Int?        @map("parcel_length_cm")
  parcelWidthCm          Int?        @map("parcel_width_cm")
  parcelHeightCm         Int?        @map("parcel_height_cm")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  order                  Order       @relation(fields: [orderId], references: [id])
  shop                   Shop        @relation(fields: [shopId], references: [id])
  items                  OrderItem[]
  voucherAllocations     OrderVoucherAllocation[]

  @@unique([orderId, shopId])
  @@index([shopId, fulfillmentStatus])
  @@map("order_shop_group")
}
