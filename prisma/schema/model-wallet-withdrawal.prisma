model WalletWithdrawal {
  id                             String             @id @default(uuid())
  walletId                       String             @map("wallet_id")
  payoutAccountId                String?            @map("payout_account_id")
  requestedByUserId              String?            @map("requested_by_user_id")
  processedByUserId              String?            @map("processed_by_user_id")
  idempotencyKey                 String?            @unique @map("idempotency_key")
  amount                         Decimal            @db.Decimal(18, 2)
  bankBin                        String?            @map("bank_bin")
  bankCode                       String?            @map("bank_code")
  bankName                       String             @map("bank_name")
  accountNumber                  String?            @map("account_number")
  accountNumberEncryptedSnapshot String?            @map("account_number_encrypted_snapshot")
  accountNumberLast4             String?            @map("account_number_last4")
  accountNumberLength            Int?               @map("account_number_length")
  accountHolder                  String             @map("account_holder")
  status                         WithdrawalStatus   @default(PENDING)
  transferReference              String?            @map("transfer_reference")
  rejectionReason                String?            @map("rejection_reason")
  createdAt                      DateTime           @default(now()) @map("created_at")
  approvedAt                     DateTime?          @map("approved_at")
  completedAt                    DateTime?          @map("completed_at")
  cancelledAt                    DateTime?          @map("cancelled_at")
  processedAt                    DateTime?          @map("processed_at")

  wallet                         Wallet             @relation(fields: [walletId], references: [id])
  payoutAccount                  PayoutAccount?     @relation(fields: [payoutAccountId], references: [id])
  requestedBy                    User?              @relation("WithdrawalRequestedBy", fields: [requestedByUserId], references: [id])
  processedBy                    User?              @relation("WithdrawalProcessedBy", fields: [processedByUserId], references: [id])

  @@index([walletId, createdAt])
  @@index([payoutAccountId])
  @@index([status, createdAt])
  @@index([transferReference])
  @@map("wallet_withdrawal")
}
